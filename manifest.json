{
  "manifest_version": 3,
  "name": "DeepSeek Harness Sound Alerts",
  "version": "1.2.3",
  "description": "Local sound alerts for DeepSeek Harness approvals, questions, plan reviews, and completed turns.",
  "permissions": [],
  "host_permissions": [
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:3080/*",
        "http://localhost:3080/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
